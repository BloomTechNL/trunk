{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/capture-mode.sh",
            "statusMessage": "Capturing TDD mode..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-tdd-state.sh",
            "statusMessage": "Guarding TDD state..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/tdd-verifier.sh",
            "statusMessage": "Verifying TDD gates...",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
