#!/usr/bin/env bash
set -eo pipefail

cargo check
cargo test
cargo fmt -- --check

# Verify all acceptance test files are declared in acceptance_tests.rs
for file in tests/acceptance/*.rs; do
    [[ "$(basename "$file")" == "mod.rs" ]] && continue
    mod_name="$(basename "$file" .rs)"
    if ! grep -q "mod $mod_name;" tests/acceptance_tests.rs; then
        echo "ERROR: $file is not declared in tests/acceptance_tests.rs"
        echo "Add: mod $mod_name;"
        exit 1
    fi
done
